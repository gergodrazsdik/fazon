{
  "name": "@fazon/adapter-vue",
  "version": "0.0.0",
  "private": true,
  "description": "The Vue 3 adapter of Fazon.",
  "license": "GPL-3.0-or-later",
  "author": "Gergő Drazsdik",
  "homepage": "https://github.com/gergodrazsdik/fazon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergodrazsdik/fazon.git",
    "directory": "packages/adapter-vue"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "templates",
    "!dist/**/*.test.*",
    "!dist/test-support.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "default": "./dist/reader.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "default": "./dist/storybook.js"
    },
    "./storybook/preview": {
      "types": "./dist/storybook-preview.d.ts",
      "default": "./dist/storybook-preview.js"
    },
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint/index.js"
    }
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@fazon/core": "workspace:*",
    "postcss-html": "2.0.1",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0",
    "vue-component-meta": "3.3.14",
    "vue-eslint-parser": "10.4.2"
  },
  "peerDependencies": {
    "@storybook/vue3-vite": "10.6.7",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "stylelint": "^18.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "10.6.7",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/browser-playwright": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "playwright": "1.65.1",
    "storybook": "10.6.7",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vitest-browser-vue": "3.1.0",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  }
}
