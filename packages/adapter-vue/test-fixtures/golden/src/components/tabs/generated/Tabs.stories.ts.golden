/** The token set's base styles, which the story frame sets so components inherit role tokens. */
const baseStyles = {
  backgroundColor: "var(--fz-color-surface-base)",
  color: "var(--fz-color-text-primary)",
  fontFamily: "var(--fz-font-family-body)",
  fontSize: "var(--fz-font-size-body)",
  fontWeight: "var(--fz-font-weight-body)",
  lineHeight: "var(--fz-line-height-body)",
};

/**
 * The story frame: 16px of padding and the base styles, with a content box as wide as the
 * fixture's frame, or as its content. The theme is the `theme` global.
 */
function frame(width?: number): Decorator {
  return (story, context) => {
    const Story = story();
    const theme: unknown = context.globals.theme ?? "light";
    const style = {
      ...baseStyles,
      display: "flow-root",
      boxSizing: "content-box",
      padding: "16px",
      width: width === undefined ? "fit-content" : `${String(width)}px`,
      colorScheme: theme === "light" || theme === "dark" ? theme : undefined,
    };
    return {
      render: () => h("div", { "data-fazon-frame": "", style }, [h(Story)]),
    };
  };
}

