// Generated by `fazon sync` from specs/tabs.md. Don't edit this file: change the spec and run `fazon sync`.
// The contract tests run in Vitest's browser mode.
import { composeStories } from "@storybook/vue3-vite";
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
import { commands } from "vitest/browser";
import api from "./api.json";
import * as stories from "./Tabs.stories";

/**
 * Reads the API of the files api.json names, in its form, with vue-component-meta: a Vitest
 * browser command the Vue adapter's Vitest configuration provides, as it runs on the server.
 */
function readApi(): Promise<unknown> {
  return (
    commands as unknown as { fazonVueApi: () => Promise<unknown> }
  ).fazonVueApi();
}

describe("Tabs: contract-api", () => {
  it("matches the approved API in api.json", async () => {
    expect(await readApi()).toEqual(api.components);
  });
});

describe("Tabs: contract-render", () => {
  const logged: unknown[][] = [];

  beforeEach(() => {
    logged.length = 0;
    vi.spyOn(console, "error").mockImplementation((...args: unknown[]) => {
      logged.push(["error", ...args]);
    });
    vi.spyOn(console, "warn").mockImplementation((...args: unknown[]) => {
      logged.push(["warn", ...args]);
    });
  });

  afterEach(() => {
    vi.restoreAllMocks();
  });

  it.each(Object.entries(composeStories(stories)))(
    "%s renders without an error or warning",
    async (_name, Story) => {
      await Story.run();
      expect(logged).toEqual([]);
    },
  );
});
