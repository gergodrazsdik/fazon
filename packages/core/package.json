{
  "name": "@fazon/core",
  "version": "0.0.0",
  "private": true,
  "description": "The core of Fazon: the tokens pipeline, the spec format, the loop, run records, the verifier and the judge.",
  "license": "GPL-3.0-or-later",
  "author": "Gergő Drazsdik",
  "homepage": "https://github.com/gergodrazsdik/fazon#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergodrazsdik/fazon.git",
    "directory": "packages/core"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/agent/test-support.*",
    "!dist/checks/test-support.*",
    "!dist/verify/test-support.*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stylelint": {
      "types": "./dist/lint/stylelint/plugin.d.ts",
      "default": "./dist/lint/stylelint/plugin.js"
    }
  },
  "dependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.14.1",
    "pixelmatch": "8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "7.0.0",
    "postcss-value-parser": "4.2.0",
    "publint": "0.3.25",
    "style-dictionary": "5.8.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "stylelint": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "postcss": "8.5.33",
    "stylelint": "18.0.0"
  }
}
