{
  "$description": "The token set of the tokens check's fixtures: a subset of the example library's draft token set (docs/spec/example-library/tokens/). Raw tokens hold values; role tokens reference them.",
  "color": {
    "blue": {
      "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1294, 0.3294, 0.851], "hex": "#2154d9" } }
    },
    "neutral": {
      "0": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "900": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1098, 0.1216, 0.1451], "hex": "#1c1f25" } }
    },
    "surface": {
      "base": { "$type": "color", "$value": "{color.neutral.0}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.neutral.900}" },
      "on-action": { "$type": "color", "$value": "{color.neutral.0}" }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.blue.600}" }
    }
  },
  "space": {
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "inset": {
      "sm": { "$type": "dimension", "$value": "{space.2}" },
      "md": { "$type": "dimension", "$value": "{space.3}" }
    }
  },
  "radius": {
    "2": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "control": { "$type": "dimension", "$value": "{radius.2}" }
  },
  "font-family": {
    "inter": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": "{font-family.inter}" }
  },
  "font-size": {
    "2": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
    "body": { "$type": "dimension", "$value": "{font-size.2}" }
  },
  "font-weight": {
    "400": { "$type": "fontWeight", "$value": 400 },
    "500": { "$type": "fontWeight", "$value": 500 },
    "body": { "$type": "fontWeight", "$value": "{font-weight.400}" },
    "medium": { "$type": "fontWeight", "$value": "{font-weight.500}" }
  },
  "line-height": {
    "2": { "$type": "number", "$value": 1.5 },
    "body": { "$type": "number", "$value": "{line-height.2}" }
  }
}
