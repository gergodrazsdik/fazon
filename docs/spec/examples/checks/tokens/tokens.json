{
  "$description": "The token set of the tokens check's fixtures. Raw tokens hold values; role tokens reference raw tokens. Placeholder names until the token set (T-0033).",
  "color": {
    "blue": { "600": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.1216, 0.3098, 0.8196], "hex": "#1f4fd1" } } },
    "white": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "action": { "primary": { "$type": "color", "$value": "{color.blue.600}" } },
    "text": { "on-action": { "$type": "color", "$value": "{color.white}" } }
  },
  "space": {
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "inset": {
      "sm": { "$type": "dimension", "$value": "{space.2}" },
      "md": { "$type": "dimension", "$value": "{space.4}" }
    }
  },
  "radius": {
    "2": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
    "control": { "$type": "dimension", "$value": "{radius.2}" }
  },
  "font-family": {
    "system": { "$type": "fontFamily", "$value": ["system-ui", "sans-serif"] },
    "body": { "$type": "fontFamily", "$value": "{font-family.system}" }
  },
  "font-size": {
    "3": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "body": { "$type": "dimension", "$value": "{font-size.3}" }
  },
  "font-weight": {
    "500": { "$type": "fontWeight", "$value": 500 },
    "strong": { "$type": "fontWeight", "$value": "{font-weight.500}" }
  },
  "line-height": {
    "3": { "$type": "number", "$value": 1.5 },
    "body": { "$type": "number", "$value": "{line-height.3}" }
  }
}
