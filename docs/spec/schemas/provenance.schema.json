{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fazon:schema:provenance:0",
  "title": "Fazon provenance (format version 0)",
  "description": "`<components>/<name>/generated/provenance.json`: the committed record of where a component's current code came from. Written by the harness; see docs/spec/records.md.",
  "type": "object",
  "required": ["fazon", "component", "spec", "api"],
  "additionalProperties": false,
  "properties": {
    "fazon": { "const": 0 },
    "component": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
    "spec": {
      "type": "object",
      "required": ["path", "hash"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].*\\.md$" },
        "hash": { "$ref": "#/$defs/hash" }
      }
    },
    "api": {
      "description": "The approved API: its hash, and the date of approval.",
      "type": "object",
      "required": ["hash", "approved"],
      "additionalProperties": false,
      "properties": {
        "hash": { "$ref": "#/$defs/hash" },
        "approved": { "type": "string", "format": "date" }
      }
    },
    "generation": {
      "description": "The runs that produced the current code; absent until the first accepted run.",
      "type": "object",
      "required": ["framework", "accepted", "runs", "handEdits", "costUsd"],
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "accepted": { "type": "string", "format": "date" },
        "runs": {
          "description": "The accepted run and the runs it is linked to, oldest first.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "status", "iterations", "models", "costUsd"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z][a-z0-9-]*-[0-9a-f]{4}$" },
              "kind": { "enum": ["generate", "feedback"] },
              "status": { "enum": ["passed", "needs-a-person", "stopped"] },
              "iterations": { "type": "integer", "minimum": 1 },
              "models": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
              "costUsd": { "type": "number", "minimum": 0 }
            }
          }
        },
        "handEdits": {
          "description": "How many hand edits the runs recorded.",
          "type": "integer",
          "minimum": 0
        },
        "costUsd": { "type": "number", "minimum": 0 },
        "costEstimated": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
